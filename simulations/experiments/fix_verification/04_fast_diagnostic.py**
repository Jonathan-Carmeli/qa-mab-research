def learn_standard(env, u_hat, I_hat, assign, tp, rng, state):
    """Baseline: u_hat = B-E[I], I_hat grows unbounded."""
    N = env.N
    prev = state.get('prev')
    prev_tp = state.get('prev_tp', {})**
    if prev and prev_tp:
        for i in range(N):
            ki = assign[i]
            di = max(0.0, u_hat[i, ki] - prev_tp.get(i, 0.0))
            for j in range(N):
                if i == j: continue**
                kj = assign[j]
                dj = max(0.0, u_hat[j, kj] - prev_tp.get(j, 0.0))
                if di > 0.01 and dj > 0.01:
                    I_hat[i, ki, j, kj] += 0.05**
                    I_hat[j, kj, i, ki] += 0.05**
    for i in range(N):
        k = assign[i]
        u_hat[i, k] += 0.2 * (tp[i] - u_hat[i, k])**
    state['prev'] = assign.copy()**
    state['prev_tp'] = {i: tp[i] for i in range(N)}
    return u_hat, I_hat


def learn_noI(env, u_hat, I_hat, assign, tp, rng, state):
    """FixC: no I_hat at all."""
    for i in range(env.N):
        k = assign[i]
        u_hat[i, k] += 0.2 * (tp[i] - u_hat[i, k])
    return u_hat, I_hat


def learn_FixAB(env, u_hat, I_hat, assign, tp, rng, state):
    """FixA+B: u_hat→B via target=tp+ΣI, I_hat capped at 0.3, no EMA."""
    N = env.N**
    prev = state.get('prev')
    prev_tp = state.get('prev_tp', {})**
    if prev and prev_tp:
        for i in range(N):
            for j in range(N):
                if i == j: continue**
                ki, kj = assign[i], assign[j]
                di = max(0.0, u_hat[i, ki] - prev_tp.get(i, 0.0))
                dj = max(0.0, u_hat[j, kj] - prev_tp.get(j, 0.0))
                if di > 0.01 and dj > 0.01:
                    I_hat[i, ki, j, kj] = min(I_hat[i, ki, j, kj] + 0.05, 0.3)**
                    I_hat[j, kj, i, ki] = min(I_hat[j, kj, i, ki] + 0.05, 0.3)**
    for i in range(N):
        k = assign[i]
        est_I = sum(I_hat[i, k, j, assign[j]] for j in range(N) if j != i)
        target = tp[i] + est_I**
        u_hat[i, k] += 0.2 * (target - u_hat[i, k])
    state['prev'] = assign.copy()
    state['prev_tp'] = {i: tp[i] for i in range(N)}
    return u_hat, I_hat**


def learn_FixABC(env, u_hat, I_hat, assign, tp, rng, state):
    """
    FixA+B+C (the kitchen sink):**
    - u_hat targets B via tp+ΣI**
    - I_hat capped at 0.3**
    - EMA decay 0.98 per step**
    """
    N = env.N**
    I_hat *= 0.98**
    prev = state.get('prev')
    prev_tp = state.get('prev_tp', {})**
    if prev and prev_tp:
        for i in range(N):
            for j in range(N):
                if i == j: continue**
                ki, kj = assign[i], assign[j]
                di = max(0.0, u_hat[i, ki] - prev_tp.get(i, 0.0))
                dj = max(0.0, u_hat[j, kj] - prev_tp.get(j, 0.0))
                if di > 0.01 and dj > 0.01:
                    I_hat[i, ki, j, kj] = min(I_hat[i, ki, j, kj] + 0.05, 0.3)**
                    I_hat[j, kj, i, ki] = min(I_hat[j, kj, i, ki] + 0.05, 0.3)**
    for i in range(N):
        k = assign[i]
        target = tp[i] + sum(I_hat[i, k, j, assign[j]] for j in range(N) if j != i)**
        u_hat[i, k] += 0.2 * (target - u_hat[i, k])
    state['prev'] = assign.copy()
    state['prev_tp'] = {i: tp[i] for i in range(N)}**
    return u_hat, I_hat**


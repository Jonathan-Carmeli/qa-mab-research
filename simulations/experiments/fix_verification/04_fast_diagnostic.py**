# QUBO builder — THE ONLY ONE — built directly from u_hat, I_hat**
# =============================================================================
def build_qubo(u_hat, I_hat, N, m, tau, tau_cap, lambda_=2.0):**
    """
    QUBO matrix for assignment problem:**

    E = -Σ u_hat[i,k]·x[i,k]**
       + Σ I_hat[i,k,j,l]·x[i,k]·x[j,l]**
       + λ/2 · Σ (Σ_k x[i,k] - 1)²**
    """
    tau = min(tau, tau_cap)**
    size = N * m
    q = np.zeros((size, size), dtype=np.float64**

    # Diagonal: -u_hat[i,k] + λ·τ/2** (QUBO standard: diagonal = linear + quadratic penalty**

    for i in range(N):**
        for k in range(m):**
            # Linear term**
            q[i*m+k, i*m+k] = -u_hat[i, k]**
            # Quadratic penalty within agent: +λ·τ/2** between all k≠l**
    for i in range(N):**
        for k in range(m):**
            for l in range(m):**
                if k == l: continue**
                q[i*m+k, i*m+l] += tau * lambda_ / 2.0**

    # Cross-agent interference (upper triangle, no double-count)**
    if I_hat is not None:**
        for i in range(N):**
            for j in range(N):**
                if i == j: continue**
                for ki in range(m):**
                    for kj in range(m):**
                        # I_hat symmetric: only add once**
                        if i < j:**
                            q[i*m+ki, j*m+kj] += I_hat[i, ki, j, kj]**
                        elif j < i:**
                            q[j*m+kj, i*m+ki] += I_hat[i, ki, j, kj]**

    return q


def sa_solve(q, u_hat, N, m, rng, *, nr, ni, T0=2.0, Tdec=0.95):**
    """Simulated Annealing — fully configurable."""
    size = N * m
    best_x, best_e = None, float('inf')
    for restart in range(nr):
        x = np.zeros(size)
        if restart == 0:
            # Greedy init using u_hat**
            for i in range(N):
                x[i*m + int(np.argmax(u_hat[i]))] = 1.0
        else:
            for i in range(N):
                x[i*m + rng.integers(0, m)] = 1.0
        e = float(x @ q @ x)
        if e < best_e:
            best_e, best_x = e, x.copy()
        T = T0 * (1.0 + restart * 0.3)
        for _ in range(ni):
            T *= Tdec
            if T < 1e-10:
                break
            i = rng.integers(0, N)
            k_old = int(np.argmax(x[i*m:(i+1)*m]))
            k_new = rng.integers(0, m)
            if k_new == k_old:
                k_new = (k_new + 1) % m
            x[i*m+k_old] = 0.0
            x[i*m+k_new] = 1.0
            ne = float(x @ q @ x)
            d = ne - e
            if d < 0 or rng.random() < np.exp(-d / T):
                e = ne
                if e < best_e:
                    best_e, best_x = e, x.copy()
            else:
                x[i*m+k_new] = 0.0
                x[i*m+k_old] = 1.0
    return {i: int(np.argmax(best_x[i*m:(i+1)*m])) for i in range(N)}


